/* This file will automatic applyed when using damiao_mc02 board */
&bmi08x_accel {
    fifo-watermark = <3>;
};

&bmi08x_gyro {
    fifo-watermark = <3>;
};

/ {
    remote: remote0 {
        status = "okay";
        compatible = "rp,remote";
        uart = <&uart5>;
    };
    aliases {
        remote0 = &remote;
    };

    can_rx_mgr1: can_rx_mgr1 {
        compatible = "rp,can-rx-manager";
        status = "okay";
        can-bus = <&fdcan1>;
        label = "can_rx_mgr1";
    };

    can_tx_mgr1: can_tx_mgr1 {
        compatible = "rp,can-tx-manager";
        status = "okay";
        can-bus = <&fdcan1>;
        label = "can_tx_mgr1";
    };

    can_tx_mgr2: can_tx_mgr2 {
        compatible = "rp,can-tx-manager";
        status = "okay";
        can-bus = <&fdcan2>;
        label = "can_tx_mgr2";
    };

    can_rx_mgr2: can_rx_mgr2 {
        compatible = "rp,can-rx-manager";
        status = "okay";
        can-bus = <&fdcan2>;
        label = "can_rx_mgr2";
    };

    chassis_LF:motor1{
        compatible = "rp,dji-can-motor";
        status = "okay";
        can-bus = <&fdcan1>;
        rx-manager = <&can_rx_mgr1>;
        tx-manager = <&can_tx_mgr1>;
        tx-id = <0x200>;
        rx-id = <0x201>;
        motor-type = "M3508";
        label = "chassis_lf";
        control-mode = "torque";
        Tx-feq = <1000>;
        motor-encoder = <8192>;
        motor-transmission-ratio = <19>;
    };

    chassis_LB:motor2{
        compatible = "rp,dji-can-motor";
        status = "okay";
        can-bus = <&fdcan1>;
        rx-manager = <&can_rx_mgr1>;
        tx-manager = <&can_tx_mgr1>;
        tx-id = <0x200>;
        rx-id = <0x202>;
        motor-type = "M3508";
        label = "chassis_lb";
        control-mode = "torque";
        Tx-feq = <1000>;
        motor-encoder = <8192>;
        motor-transmission-ratio = <19>;
    };

    chassis_RF:motor3{
        compatible = "rp,dji-can-motor";
        status = "okay";
        can-bus = <&fdcan1>;
        rx-manager = <&can_rx_mgr1>;
        tx-manager = <&can_tx_mgr1>;
        tx-id = <0x200>;
        rx-id = <0x203>;
        motor-type = "M3508";
        label = "chassis_rf";
        control-mode = "torque";
        Tx-feq = <1000>;
        motor-encoder = <8192>;
        motor-transmission-ratio = <19>;
    };

    chassis_RB:motor4{
        compatible = "rp,dji-can-motor";
        status = "okay";
        can-bus = <&fdcan1>;
        rx-manager = <&can_rx_mgr1>;
        tx-manager = <&can_tx_mgr1>;
        tx-id = <0x200>;
        rx-id = <0x204>;
        motor-type = "M3508";
        label = "chassis_rb";
        control-mode = "torque";
        Tx-feq = <1000>;
        motor-encoder = <8192>;
        motor-transmission-ratio = <19>;
    };

    gimbal_YAW:motor5{
        compatible = "rp,dm-can-motor";
        status = "okay";
        can-bus = <&fdcan2>;
        rx-manager = <&can_rx_mgr2>;
        tx-manager = <&can_tx_mgr2>;
        tx-id = <0x02>;
        rx-id = <0x12>;
        motor-type = "DM43";
        label = "gimbal_yaw";
        control-mode = "MIT";
        Tx-feq = <1000>;
        motor-encoder = <65535>;
        motor-transmission-ratio = <9>;
        vel-max = <45000>;          // 这里的整数都要除以1000才是实际的上限，必须与上位机的值对应
        tq-max = <54000>;
        pos-max = <3141>;
        mit-params-limit = <500000 0 5000 0>;
    };
};

/ {
    aliases {
        watchdog0 = &iwdg;  /* 将 watchdog0 指向 IWDG 硬件 */
    };
};

&iwdg {
    status = "okay"; /* 启用独立看门狗 IWDG */
};
