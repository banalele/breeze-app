{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"cmake.preferredGenerators": [
			"Ninja",
			"Unix Makefiles"
		],
		"kconfig.zephyr.base": "${workspaceFolder}/../../breeze-sdk/zephyr",
		"devicetree.zephyr": "${workspaceFolder}/../../breeze-sdk/zephyr",
		"devicetree.modules": [
			"${workspaceFolder}/../../breeze",
			"${workspaceFolder}/../../breeze-sdk/zephyr",
			"${workspaceFolder}/../../breeze-sdk/modules/*/*"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"cwd": "${workspaceRoot}",
				"executable": "./build/zephyr/zephyr.elf",
				"name": "Debug with OpenOCD",
				"request": "launch",
				"type": "cortex-debug",
				"servertype": "openocd",
				//更改openocd.cfg成适合你的开发板的配置文件
				"configFiles": [
					"/home/bana/breeze-workspace/breeze-app/wheelLeg/openocd.cfg"
				],
				"searchDir": [
					"/usr/share/openocd/scripts"
				],
				"runToEntryPoint": "main",
				"showDevDebugOutput": "parsed",
				"device": "STM32F407",
				"svdFile": "${workspaceFolder}/../../breeze/boards/damiao/mc02/support/STM32F407.svd",
				"objdumpPath": "/opt/zephyr-sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump",
				"rttConfig": {
					"enabled": true,
					"address": "0x20000000", // 使用日志中找到的控制块地址
					"searchSize": 131072,
					"searchId": "SEGGER RTT",
					"decoders": [
						{
							"port": 0,
							"type": "console"
						}
					]
				}
			}
		]
	}
}
